AUTORESEARCH_RUN_TAG=mar13-simd
AUTORESEARCH_BASE_BRANCH=perf/autoresearch-experiments
AUTORESEARCH_AGENT=codex
AUTORESEARCH_AGENT_MODEL=
AUTORESEARCH_AGENT_SANDBOX=workspace-write
